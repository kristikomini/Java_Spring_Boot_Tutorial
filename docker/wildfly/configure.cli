# =============================================================================
# WildFly configuration script, executed at IMAGE BUILD time by jboss-cli
# =============================================================================
# jboss-cli is WildFly's administrative command line. Everything here could also
# be done by clicking through the web console at :9990 - but a script can be
# reviewed, versioned in git and replayed identically on every environment.
#
# "Configuration as code" is the point. A server someone configured by hand is a
# server nobody can rebuild.
#
# embed-server starts WildFly in-process, WITHOUT opening any ports, applies the
# changes to standalone.xml, and exits. That is what lets us bake configuration
# into a Docker image instead of running a fragile "wait for boot, then
# configure" script at container startup.
# =============================================================================

embed-server --server-config=standalone.xml --std-out=echo

# -----------------------------------------------------------------------------
# 1. Register the PostgreSQL JDBC driver as a WildFly MODULE
# -----------------------------------------------------------------------------
# WildFly has a modular classloader: a jar is not simply "on the classpath", it
# is a named module with declared dependencies. This is what allows two
# applications on the same server to use different versions of a library.
#
#   java.sql                - the driver implements java.sql.Driver
#   jakarta.transaction.api - needed for XA / distributed transactions
#
# The alternative is to drop the driver jar into standalone/deployments and let
# WildFly detect it. That is quicker but makes the driver part of your
# deployment rather than part of the server, which is the wrong layer.
# -----------------------------------------------------------------------------
module add \
    --name=org.postgresql \
    --resources=/opt/jboss/wildfly/customization/postgresql.jar \
    --dependencies=java.sql,jakarta.transaction.api

/subsystem=datasources/jdbc-driver=postgresql:add( \
    driver-name=postgresql, \
    driver-module-name=org.postgresql, \
    driver-class-name=org.postgresql.Driver, \
    driver-xa-datasource-class-name=org.postgresql.xa.PGXADataSource)

# -----------------------------------------------------------------------------
# 2. Define the datasource
# -----------------------------------------------------------------------------
# This is the JNDI name persistence.xml refers to:
#     <jta-data-source>java:jboss/datasources/EnrollmentDS</jta-data-source>
#
# The application never sees a host, a port or a password. That indirection is
# what lets the identical WAR run against dev, staging and production.
#
# CONNECTION POOLING is the other reason a datasource exists. Opening a TCP
# connection and authenticating costs milliseconds - an eternity if you do it per
# request. The pool keeps connections open and hands them out.
#
#   min-pool-size / max-pool-size
#       The pool is a QUEUE, not a magic scaling device. Sizing it larger than
#       the database can handle simply moves the bottleneck. A common starting
#       rule is (core_count * 2) + effective_spindle_count; measure, do not guess.
#
#   background-validation
#       Periodically checks idle connections so a firewall or database restart
#       that silently killed them is discovered by the pool, not by a user
#       request.
#
#   check-valid-connection-sql
#       The cheapest possible statement that proves a connection still works.
# -----------------------------------------------------------------------------
data-source add \
    --name=EnrollmentDS \
    --jndi-name=java:jboss/datasources/EnrollmentDS \
    --driver-name=postgresql \
    --connection-url=jdbc:postgresql://postgres:5432/enrollment \
    --user-name=enrollment \
    --password=enrollment \
    --jta=true \
    --use-java-context=true \
    --enabled=true \
    --min-pool-size=5 \
    --max-pool-size=25 \
    --pool-prefill=true \
    --blocking-timeout-wait-millis=5000 \
    --idle-timeout-minutes=5 \
    --background-validation=true \
    --background-validation-millis=60000 \
    --check-valid-connection-sql="SELECT 1"

# -----------------------------------------------------------------------------
# 3. Put the correlation id into every log line
# -----------------------------------------------------------------------------
# %X{correlationId} reads the MDC (Mapped Diagnostic Context) key that
# CorrelationIdFilter sets at the start of each request. Without this line the
# filter still works, but the id never appears in the log - and the whole point
# of it is to be greppable.
#
# Reading the pattern:
#   %d{HH:mm:ss,SSS}  timestamp
#   %-5p              level, left-padded to 5 characters so columns line up
#   %c{1.}            logger name, abbreviated (i.u.c.e.service.EnrollmentService)
#   %X{correlationId} our per-request id
#   %s                the message
#   %e                the exception and its stack trace, if any
#   %n                platform newline
# -----------------------------------------------------------------------------
/subsystem=logging/pattern-formatter=COLOR-PATTERN:write-attribute( \
    name=pattern, \
    value="%K{level}%d{HH:mm:ss,SSS} %-5p [%c{1.}] [%X{correlationId}] %s%e%n")

/subsystem=logging/pattern-formatter=PATTERN:write-attribute( \
    name=pattern, \
    value="%d{yyyy-MM-dd HH:mm:ss,SSS} %-5p [%c] [%X{correlationId}] %s%e%n")

# -----------------------------------------------------------------------------
# 4. Turn the application's own logging up to DEBUG
# -----------------------------------------------------------------------------
# Two separate levels have to allow a message through:
#   - the LOGGER (category) level, set per package;
#   - the HANDLER level, set per destination.
# A DEBUG message from a DEBUG logger is still discarded by an INFO handler.
# Forgetting the second one is the usual reason "I set it to DEBUG and nothing
# happened".
#
# DEBUG is deliberate here so that the @Loggable interceptor's timings are
# visible while learning. In production this would stay at INFO.
# -----------------------------------------------------------------------------
/subsystem=logging/console-handler=CONSOLE:write-attribute(name=level,value=DEBUG)

/subsystem=logging/logger=it.unicam.cs.enrollment:add(level=DEBUG)

# Hibernate's SQL output. persistence.xml already enables show_sql; raising this
# category to DEBUG is the route that goes through the logging subsystem, so the
# statements carry the correlation id like everything else.
/subsystem=logging/logger=org.hibernate.SQL:add(level=DEBUG)

# -----------------------------------------------------------------------------
# 5. Make the deployment scanner MARKER-DRIVEN rather than timestamp-driven
# -----------------------------------------------------------------------------
# By default the scanner auto-deploys any .war it finds, and then decides whether
# to REdeploy by comparing the archive's last-modified time against the .deployed
# marker file it wrote next to it.
#
# That comparison is unreliable across a Docker bind mount on Windows and macOS.
# The marker is written through the mount and comes back with its sub-second
# precision truncated (...:57.000), while the WAR keeps its own (...:57.571). The
# scanner therefore sees an archive that is permanently "newer" than its own
# marker, and redeploys it every scan-interval - forever, about ten times a
# minute. The symptom is not an error message. It is requests that intermittently
# return 404 because the web context is momentarily unregistered, and 500s
# carrying IJ000459 ("Transaction is not active") from requests that were in
# flight when the old context was torn down.
#
# Turning auto-deploy off makes deployment EXPLICIT: the scanner acts only when
# it finds an enrollment.war.dodeploy marker, and no timestamp is ever compared.
# Maven writes that marker at the end of `package` (see pom.xml), so the
# development loop is unchanged - `mvn package` still redeploys, exactly once,
# within a second or two.
#
# Marker files are WildFly's documented mechanism, not a workaround:
#   .dodeploy     you are asking for a deployment
#   .isdeploying  the scanner is working on it
#   .deployed     it succeeded
#   .failed       it did not - the file contains the reason
# -----------------------------------------------------------------------------
/subsystem=deployment-scanner/scanner=default:write-attribute( \
    name=auto-deploy-zipped, \
    value=false)

# -----------------------------------------------------------------------------
# 6. A mail session, pointing at the Mailpit container
# -----------------------------------------------------------------------------
# Exactly the same idea as the datasource in §2, for exactly the same reason:
# the application asks for "java:jboss/mail/Enrollment" and never learns a host
# name, a port or a password. Moving from Mailpit to a real university relay is
# then a change to this file and a redeploy of nothing.
#
# It takes two resources, and the split confuses people the first time:
#
#   a REMOTE-DESTINATION OUTBOUND SOCKET BINDING
#       says WHERE. Host and port, named once, in the socket-binding group with
#       every other address the server knows. WildFly keeps all networking
#       endpoints in one place so an operator can see, and change, every
#       destination a server talks to without reading application config.
#
#   a MAIL SESSION
#       says WHAT: a jakarta.mail.Session, bound into JNDI, referring to the
#       binding above for its address. Credentials and TLS settings live here.
#
# `mailpit` is a DNS name inside the Docker network, resolved to the container
# of that name by Docker's embedded resolver - the same mechanism that lets the
# datasource say `postgres`. Port 1025 is the CONTAINER's port, not the shifted
# host port in docker-compose.yml, because this connection never leaves the
# Docker network.
#
# The stock configuration already ships a `default` mail session pointing at
# localhost:25. It is left alone: adding our own named session, rather than
# editing theirs, means an upgrade of the base image cannot silently change what
# our application connects to.
/socket-binding-group=standard-sockets/remote-destination-outbound-socket-binding=mail-smtp-enrollment:add( \
    host=mailpit, \
    port=1025)

/subsystem=mail/mail-session=enrollment:add( \
    jndi-name=java:jboss/mail/Enrollment, \
    from=no-reply@enrollment.unicam.test)

# ssl=false, tls=false because Mailpit speaks plain SMTP on 1025 and nothing
# leaves this machine. Against any real relay both of those become true and a
# username/password (or, better, credential-reference to a secret store) is
# added here - and note that this is the ONE place it would have to change.
/subsystem=mail/mail-session=enrollment/server=smtp:add( \
    outbound-socket-binding-ref=mail-smtp-enrollment, \
    ssl=false, \
    tls=false)

stop-embedded-server
