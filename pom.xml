<?xml version="1.0" encoding="UTF-8"?>
<!--
  ============================================================================
  THE BUILD FILE
  ============================================================================
  A Maven POM answers four questions, and it is worth reading it with those in
  mind rather than as configuration soup.

    1. WHO am I?          -> <groupId> + <artifactId> + <version>
    2. WHAT do I produce? -> <packaging>jar</packaging>
    3. WHAT do I need?    -> <dependencies>
    4. HOW is it built?   -> <build><plugins>

  The single most important line in this file is the <parent>. Spring Boot's
  starter parent is a curated BOM - a Bill Of Materials - that has already
  chosen and tested a compatible version of Hibernate, Jackson, Tomcat, SLF4J,
  JUnit, Mockito and about three hundred other things. That is why almost no
  dependency below carries a <version> tag. You are not being lazy by omitting
  them; you are deliberately deferring to a combination somebody else has
  already integration-tested.

  The second most important idea is DEPENDENCY SCOPE. `compile` (the default)
  means "I need this to build and to run". `runtime` means "not on the compiler's
  classpath, but ship it" - the PostgreSQL driver is the canonical example,
  because your code should be talking to JDBC interfaces, never to
  `org.postgresql` classes. `test` means "tests only, never shipped".
  If you can move a dependency to `runtime`, the compiler will then enforce
  that you did not accidentally import from it.
  ============================================================================
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
      THE PARENT.

      Inheriting from spring-boot-starter-parent gets you three things at once:
      the dependency management described above, sensible plugin configuration
      (the compiler is already set to your Java version, resources are already
      filtered), and the `spring-boot-maven-plugin` wired to repackage the jar
      into an executable one.

      `<relativePath/>` - empty on purpose - tells Maven "do not look for this
      parent in the directory above me, go to the repository". Without it Maven
      wastes time checking `../pom.xml` and prints a warning.
    -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.0</version>
        <relativePath/>
    </parent>

    <groupId>it.unicam.cs.enrollment</groupId>
    <artifactId>spring-boot-tutorial</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>jar</packaging>

    <name>Java Spring Boot Tutorial</name>
    <description>
        A Spring Boot reference application, built to be read: a university
        course enrollment service with JPA persistence, Spring MVC, validation,
        transactions and scheduled work - plus the fieldbook, a course that
        teaches the whole thing chapter by chapter.
    </description>

    <!--
        Stating the licence in the POM as well as in LICENSE is not redundant.
        LICENSE is what GitHub reads to label the repository; this block is what
        build and dependency-scanning tools read. A project published without it
        shows up as "unknown licence" in exactly the automated report that
        decides whether a company is allowed to use it.
    -->
    <licenses>
        <license>
            <name>MIT License</name>
            <url>https://opensource.org/licenses/MIT</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <properties>
        <java.version>21</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

        <!--
          The exercise tests are the reader's homework. They fail until the
          exercise is solved, so a normal `mvn test` must not run them - see
          the `exercises` profile at the bottom for how to turn them on.
        -->
        <excluded.test.groups>exercise</excluded.test.groups>

        <!-- Versions the parent does not manage, so they must be stated. -->
        <version.springdoc>2.8.5</version.springdoc>
        <version.mapstruct>1.6.3</version.mapstruct>
        <version.resilience4j>2.3.0</version.resilience4j>
        <version.flapdoodle>4.20.0</version.flapdoodle>
        <version.plugin.flyway>13.5.0</version.plugin.flyway>
        <version.postgresql.driver>42.7.13</version.postgresql.driver>
    </properties>

    <dependencies>

        <!--
          ====================================================================
          THE STARTERS
          ====================================================================
          A "starter" contains no code of its own. It is a pom whose only job
          is to pull in a coherent set of libraries plus the auto-configuration
          that wires them together. `spring-boot-starter-web` alone brings in
          Spring MVC, Jackson, validation glue and an embedded Tomcat, and
          arranges for an HTTP port to be listening when `main()` runs.

          This is the single biggest day-to-day difference from a Jakarta EE
          build, where those pieces come from the application server instead
          and are therefore `provided` rather than bundled.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!--
          Actuator adds operational endpoints - /actuator/health, /metrics,
          /info - without you writing any of them. In production a readiness
          probe hitting /actuator/health/readiness is how the orchestrator
          knows whether to send traffic to this instance.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!--
          Aspect-oriented programming, used here by the @Loggable aspect in
          common/logging. Spring's declarative features - @Transactional,
          @Cacheable, @Async - are all built on the same proxying machinery,
          so understanding this one aspect explains the rest of them.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-aop</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-cache</artifactId>
        </dependency>
        <dependency>
            <groupId>com.github.ben-manes.caffeine</groupId>
            <artifactId>caffeine</artifactId>
        </dependency>

        <!--
          Mail. The fieldbook's password-reset flow queues messages in an
          outbox table and a scheduled job delivers them, so this is here for
          the jakarta.mail API that mail/transport/SmtpMailTransport talks to
          directly. Locally there is no SMTP server and the logging transport
          is used instead - see MailConfig.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-mail</artifactId>
        </dependency>

        <!--
          Flyway runs the SQL migrations in src/main/resources/db/migration on
          startup, so the schema is versioned in git next to the code that
          expects it. `spring.jpa.hibernate.ddl-auto` stays `validate`: Flyway
          owns the schema, Hibernate only checks that the entities agree with
          it. Letting Hibernate generate the schema is fine for a demo and a
          liability for anything that holds real data.
        -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>

        <!-- Interactive API documentation at /swagger-ui.html, generated from the controllers. -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>${version.springdoc}</version>
        </dependency>

        <!-- Prometheus scrape endpoint, exposed through Actuator. -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!--
          MapStruct generates the entity -> DTO mapper implementations at
          COMPILE time from the interfaces in web/mapper. Generated code you
          can read and step through, with no reflection at runtime; see the
          annotationProcessorPaths block further down, which is what actually
          switches the generator on.
        -->
        <dependency>
            <groupId>org.mapstruct</groupId>
            <artifactId>mapstruct</artifactId>
            <version>${version.mapstruct}</version>
        </dependency>

        <!--
          MongoDB, used by the read-model projection in `document`. It is off
          unless the `mongo` profile is active - the point of the package is to
          show a document store beside the relational one, not to require it.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-mongodb</artifactId>
        </dependency>

        <!-- Circuit breaker and retry around the outbound notification call. -->
        <dependency>
            <groupId>io.github.resilience4j</groupId>
            <artifactId>resilience4j-spring-boot3</artifactId>
            <version>${version.resilience4j}</version>
        </dependency>

        <!--
          `runtime`, not `compile`. Application code never names a PostgreSQL
          class - it talks to JDBC and JPA interfaces - and this scope is how
          the compiler enforces that.
        -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!--
          ====================================================================
          TEST DEPENDENCIES
          ====================================================================
          `spring-boot-starter-test` is JUnit 5, AssertJ, Mockito, Hamcrest,
          JSONassert and Spring's own test support in one line.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!--
          In-memory database, for the fast slice tests AND for the `demo`
          profile - `mvn spring-boot:run -Dspring-boot.run.profiles=demo`
          starts the whole application on H2 with seed data and no Docker.
          That second use is why the scope is `runtime` rather than `test`:
          with `test` the demo profile fails at startup with
          "Cannot load driver class: org.h2.Driver", which is a genuinely
          confusing error for a missing scope.
        -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- An embedded MongoDB for the document tests, so CI needs no Mongo. -->
        <dependency>
            <groupId>de.flapdoodle.embed</groupId>
            <artifactId>de.flapdoodle.embed.mongo.spring3x</artifactId>
            <version>${version.flapdoodle}</version>
            <scope>test</scope>
        </dependency>

        <!--
          Testcontainers starts a REAL PostgreSQL in Docker for the integration
          tests. The distinction matters: H2 in Postgres-compatibility mode
          will happily accept SQL that Postgres rejects, so a test suite that
          only ever sees H2 gives you confidence you have not earned.
        -->
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>postgresql</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-testcontainers</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>enrollment</finalName>

        <plugins>
            <!--
              Repackages the plain jar into an executable one with a nested
              class loader, so `java -jar target/enrollment.jar` starts the
              whole application - embedded Tomcat included. This is the plugin
              that makes "the server lives inside the jar" true.
            -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.mapstruct</groupId>
                            <artifactId>mapstruct-processor</artifactId>
                            <version>${version.mapstruct}</version>
                        </path>
                    </annotationProcessorPaths>
                    <compilerArgs>
                        <!--
                          `unmappedTargetPolicy=ERROR` turns "you added a field
                          to the DTO and forgot to map it" from a silent null
                          into a compile failure. It is the reason to use a
                          generator rather than hand-written mappers.
                        -->
                        <arg>-Amapstruct.unmappedTargetPolicy=ERROR</arg>
                        <arg>-Amapstruct.defaultComponentModel=spring</arg>
                        <!-- Keep parameter names in the bytecode, for Spring MVC binding. -->
                        <arg>-parameters</arg>
                    </compilerArgs>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <excludedGroups>${excluded.test.groups}</excludedGroups>
                </configuration>
            </plugin>

            <!--
              Failsafe runs *IT.java in the `integration-test` phase, AFTER
              packaging, and - unlike Surefire - does not fail the build the
              instant a test fails; it records the failure and lets `verify`
              report it, so the environment it started can still be torn down.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <configuration>
                    <excludedGroups>${excluded.test.groups}</excludedGroups>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!--
          `mvn test -Pexercises` runs ONLY the exercise tests - the homework in
          src/main/java/.../exercises. They fail until you implement the method
          bodies, which is the point; the default build skips them so that a
          red build always means something is genuinely broken.
        -->
        <profile>
            <id>exercises</id>
            <properties>
                <excluded.test.groups></excluded.test.groups>
            </properties>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-surefire-plugin</artifactId>
                        <configuration>
                            <groups>exercise</groups>
                        </configuration>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-failsafe-plugin</artifactId>
                        <configuration>
                            <groups>exercise</groups>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <!--
          The application runs its own migrations at startup, so this profile
          is only for inspecting and repairing the schema by hand:

              mvn -Pflyway flyway:info      (read-only, safe)
              mvn -Pflyway flyway:validate

          It points at the Docker Postgres on port 55433.
        -->
        <profile>
            <id>flyway</id>
            <properties>
                <flyway.url>jdbc:postgresql://localhost:55433/enrollment</flyway.url>
                <flyway.user>enrollment</flyway.user>
                <flyway.password>enrollment</flyway.password>
                <flyway.locations>filesystem:src/main/resources/db/migration</flyway.locations>
            </properties>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.flywaydb</groupId>
                        <artifactId>flyway-maven-plugin</artifactId>
                        <version>${version.plugin.flyway}</version>
                        <dependencies>
                            <dependency>
                                <groupId>org.postgresql</groupId>
                                <artifactId>postgresql</artifactId>
                                <version>${version.postgresql.driver}</version>
                            </dependency>
                            <dependency>
                                <groupId>org.flywaydb</groupId>
                                <artifactId>flyway-database-postgresql</artifactId>
                                <version>${version.plugin.flyway}</version>
                            </dependency>
                        </dependencies>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
