# =============================================================================
# Template for .env.prod - the production secrets file
# =============================================================================
# Copy this to .env.prod ON THE SERVER, fill it in, and never commit it:
#
#     cp .env.prod.example .env.prod
#     nano .env.prod
#     chmod 600 .env.prod
#
# .gitignore already excludes .env.prod and admits this example. The chmod is
# not decoration - the default 644 makes it world-readable, and "world" on a
# shared or compromised box includes processes you did not start.
#
# Everything here is read by docker-compose.prod.yml, which passes the values
# into the containers as environment variables. Compose reads this file only
# when you point it at one:
#
#     docker compose --env-file .env.prod -f docker-compose.prod.yml up -d
#
# Forget --env-file and the ${VAR:?...} guards in the compose file stop the
# command with a message naming the first missing variable. That is intended:
# a deploy that silently used defaults for your database password would be
# worse than one that refused.
# =============================================================================


# -----------------------------------------------------------------------------
# The site
# -----------------------------------------------------------------------------
# The domain Caddy will request a certificate for. It must already resolve to
# this server's public IP - Let's Encrypt verifies by connecting back to it, so
# a wrong or not-yet-propagated record is the usual cause of a first deploy
# that comes up on HTTP and never gets HTTPS.
#
# No scheme, no trailing slash, no port. Just the name.
SITE_DOMAIN=enrollment.example.com

# Where certificate-expiry warnings go. Use an address you read.
ACME_EMAIL=you@example.com


# -----------------------------------------------------------------------------
# The database
# -----------------------------------------------------------------------------
# One value, used twice: PostgreSQL initialises its user with it, and WildFly's
# datasource authenticates with it. Keeping it to a single variable removes the
# failure mode where the two drift apart and the symptom is a pool that cannot
# fill.
#
# Generate one rather than inventing one:
#     openssl rand -base64 30
#
# CAUTION: PostgreSQL sets this password only when it initialises an EMPTY data
# directory. Change it later and the container will happily start with the old
# password while WildFly tries the new one. Changing it for real means either
# `ALTER USER` inside psql, or destroying the volume - which destroys the data.
ENROLLMENT_DB_PASSWORD=


# -----------------------------------------------------------------------------
# Mail
# -----------------------------------------------------------------------------
# `log` writes every message to the application log and delivers nothing.
# `smtp` sends through the relay configured below, and fails at startup if the
#        mail session is not there.
#
# Leave this at `log` for the first deploy. Turn it to `smtp` only once you
# have a relay and have thought about who can trigger a send - on this
# application, anyone who can reach the registration page can.
ENROLLMENT_MAIL_TRANSPORT=log

# Only consulted when the transport is smtp, but read by WildFly at boot in
# either case, so they need to be syntactically valid.
#
# Ports and the ssl/tls pair, since the naming is confusing:
#     port 587 + TLS=true,  SSL=false   STARTTLS. What most relays want.
#     port 465 + SSL=true,  TLS=false   implicit TLS.
# Never both true.
ENROLLMENT_SMTP_HOST=smtp.example.com
ENROLLMENT_SMTP_PORT=587
ENROLLMENT_SMTP_SSL=false
ENROLLMENT_SMTP_TLS=true
ENROLLMENT_SMTP_USER=
ENROLLMENT_SMTP_PASSWORD=

# The envelope sender. It must be an address the relay is willing to send as -
# SPF and DKIM are checked against the domain here, and a mismatch is why mail
# that "sends successfully" lands in spam.
ENROLLMENT_MAIL_FROM=no-reply@example.com
ENROLLMENT_MAIL_FROM_NAME=UNICAM Enrollment

# Marks every subject line. This is a teaching deployment of a fictional
# registrar; the prefix is what stops one of its messages being mistaken for
# correspondence from a real university. Keep it.
ENROLLMENT_MAIL_SUBJECT_PREFIX=[DEMO]
