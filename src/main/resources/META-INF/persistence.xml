<?xml version="1.0" encoding="UTF-8"?>
<!--
  ============================================================================
  persistence.xml  -  THE JPA DEPLOYMENT DESCRIPTOR
  ============================================================================
  This file defines a PERSISTENCE UNIT: a named set of entity classes plus the
  database they map to. It must live at META-INF/persistence.xml on the
  classpath - the JPA provider scans for exactly that path.

  Vocabulary you will hear every day:

    Persistence Unit (PU)  the configuration block below. Named "enrollmentPU".
    EntityManagerFactory   heavyweight, one per PU, created at deploy time.
    EntityManager (EM)     lightweight, one per transaction. Your handle to the
                           persistence context.
    Persistence Context    the EM's in-memory cache of managed entities. Any
                           change to a *managed* entity is written to the DB
                           automatically at flush/commit - you never call
                           update(). This is called "dirty checking".
    JPA provider           the implementation. WildFly ships Hibernate.
  ============================================================================
-->
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence
                                 https://jakarta.ee/xml/ns/persistence/persistence_3_2.xsd"
             version="3.2">

    <!--
      transaction-type="JTA" means the *container* owns the transactions.
      We annotate a service method with @Transactional and the server begins,
      commits or rolls back around it. The alternative, RESOURCE_LOCAL, forces
      you to write em.getTransaction().begin()/commit() by hand - that is what
      the test persistence unit uses, since there is no container in a unit test.
    -->
    <persistence-unit name="enrollmentPU" transaction-type="JTA">

        <!--
          A JNDI name, not a URL. The actual host/user/password live in the
          application server configuration (see docker/wildfly/configure.cli).
          This indirection is deliberate: the same WAR can be deployed to dev,
          staging and production untouched, because credentials are an
          *operational* concern, not a source-code concern.
        -->
        <jta-data-source>java:jboss/datasources/EnrollmentDS</jta-data-source>

        <!--
          Fail fast: if a class is annotated @Entity but not listed and not
          discovered, throw at deploy time instead of misbehaving at runtime.
          WildFly auto-discovers entities inside the same archive, so we do not
          need to list them one by one - but we do want the strict check.
        -->
        <exclude-unlisted-classes>false</exclude-unlisted-classes>

        <!--
          Second-level cache. NONE keeps the mental model simple while learning:
          every query hits the database. ENABLE_SELECTIVE + @Cacheable is the
          production setting once you know what you are doing.
        -->
        <shared-cache-mode>NONE</shared-cache-mode>

        <!-- Bean Validation runs automatically on @PrePersist/@PreUpdate. -->
        <validation-mode>AUTO</validation-mode>

        <properties>

            <!--
              SCHEMA GENERATION
              "update" lets Hibernate ALTER the schema to match the entities on
              every deploy. It is wonderful for learning and FORBIDDEN in
              production - it never drops columns, cannot be reviewed, and has
              no rollback. Real teams use Flyway or Liquibase: versioned SQL
              migration files checked into git and applied in order.
            -->
            <property name="jakarta.persistence.schema-generation.database.action"
                      value="update"/>

            <!--
              Note: we deliberately do NOT use
              `jakarta.persistence.sql-load-script-source` for demo data. That
              script re-runs on every deploy and would explode on unique-key
              violations the second time. Seeding is done instead by
              ApplicationBootstrap, which checks whether data already exists -
              i.e. it is IDEMPOTENT. "Safe to run twice" is a property worth
              designing for in anything that runs at startup.
            -->

            <!--
              Print the SQL Hibernate generates. Indispensable while learning:
              you *see* the N+1 select problem instead of guessing about it.
              Turn off in production - it is a real throughput cost.
            -->
            <property name="hibernate.show_sql" value="true"/>
            <property name="hibernate.format_sql" value="true"/>
            <property name="hibernate.highlight_sql" value="false"/>

            <!--
              Batching: Hibernate groups INSERTs/UPDATEs into JDBC batches
              instead of one round trip each. Combined with the sequence
              allocationSize in BaseEntity this is the classic write-throughput
              tuning pair.
            -->
            <property name="hibernate.jdbc.batch_size" value="25"/>
            <property name="hibernate.order_inserts" value="true"/>
            <property name="hibernate.order_updates" value="true"/>

            <!--
              Throws an exception if a query is executed while pagination is
              applied to an in-memory-joined collection - a subtle correctness
              trap. Failing loudly is better than silently wrong data.
            -->
            <property name="hibernate.query.fail_on_pagination_over_collection_fetch"
                      value="true"/>

            <!--
              ==================================================================
              ALIASED FETCH JOINS - a genuine spec-versus-reality wrinkle
              ==================================================================
              Deploying without this property fails at startup with:

                  StrictJpaComplianceViolation: Encountered aliased fetch join,
                  but strict JPQL compliance was requested

              The cause is queries like:

                  SELECT e FROM Enrollment e
                  JOIN FETCH e.course c        <- the alias 'c' ...
                  JOIN FETCH c.professor       <- ... so we can fetch through it

              Jakarta Persistence 3.1 says a fetch join may NOT be given an
              alias. Taken literally that makes NESTED fetching impossible -
              there is no other way to say "fetch the course, and also fetch that
              course's professor". Every provider therefore supports it anyway,
              it is used universally, and JPA 3.2 finally legalised it.

              WildFly asks Hibernate for strict compliance by default. We turn
              that one check off, deliberately and in one visible place.

              WHY THIS DID NOT SHOW UP IN THE TESTS
              The H2 test persistence unit bootstraps Hibernate directly, so
              strict mode was never enabled and the same queries passed. That is
              a perfect illustration of the limits of testing against a different
              setup from the one you deploy to - and an argument for
              Testcontainers plus a real container test.

              THE SPEC-PURE ALTERNATIVE
              @NamedEntityGraph declares a fetch plan as metadata rather than in
              the query string, and is fully compliant. It is more verbose and
              harder to read at the call site, which is why fetch joins remain
              the common choice.
            -->
            <property name="hibernate.jpa.compliance.query" value="false"/>

            <!--
              ==================================================================
              GLOBAL ID GENERATORS - the second strict-compliance switch
              ==================================================================
              Deploying without this fails at startup with:

                  IllegalArgumentException: Duplicate generator name
                  app_id_generator

              BaseEntity declares @SequenceGenerator(name = "app_id_generator")
              once, on a @MappedSuperclass. Every entity that extends it
              therefore inherits that declaration - which is the entire point of
              putting it there, and how the quartet of id/version/createdAt/
              updatedAt stays written once instead of ten times.

              Jakarta Persistence 3.2 tightened the rule that generator names
              live in a GLOBAL namespace, and Hibernate 7 enforces it: ten
              entities inheriting one declaration now look like ten entities
              REGISTERING the same name, and the tenth is rejected as a
              duplicate. Hibernate's own message suggests this property, which
              restores the previous behaviour of resolving generator names per
              entity.

              The spec-pure alternative is to move the @SequenceGenerator off
              the mapped superclass and repeat it - with a distinct name - on
              every entity. That is more faithful to the letter of the spec and
              strictly worse code: ten copies of one decision, and a new entity
              that silently gets its own sequence the day someone forgets.

              Note again that the H2 test persistence unit bootstraps Hibernate
              directly and never enables strict compliance, so the whole suite
              passes with this property absent. The same lesson as the fetch-join
              switch above: a test that runs against a different configuration
              from production can only tell you about the configuration it ran
              against.
            -->
            <property name="hibernate.jpa.compliance.global_id_generators" value="false"/>

        </properties>
    </persistence-unit>
</persistence>
