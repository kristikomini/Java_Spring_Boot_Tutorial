<?xml version="1.0" encoding="UTF-8"?>
<!--
  ============================================================================
  jboss-deployment-structure.xml  -  A VENDOR-SPECIFIC DESCRIPTOR
  ============================================================================
  Everything else in WEB-INF/ is standard Jakarta EE and portable to any
  server. This one is WildFly/JBoss only, and it exists because of WildFly's
  modular classloader.

  WildFly does NOT put its whole runtime on your classpath. Each deployment
  gets an isolated module graph and only sees:
    - classes inside its own WAR
    - a small set of "implicit" modules the server adds for you
    - anything you explicitly request here

  That isolation is why two applications on the same server can use different
  library versions without conflicting - a real problem in the days of a single
  flat classpath.

  Below we explicitly request org.slf4j. WildFly usually adds it implicitly,
  but declaring it makes the dependency visible and self-documenting instead of
  relying on server defaults that could change between versions.

  The equivalent file on other servers:
    Payara/GlassFish -> glassfish-web.xml
    WebLogic         -> weblogic.xml
    WebSphere        -> ibm-web-bnd.xml
  ============================================================================
-->
<jboss-deployment-structure xmlns="urn:jboss:deployment-structure:1.3"
                            version="1.3">
    <deployment>
        <dependencies>
            <!-- The SLF4J facade we compile against. -->
            <module name="org.slf4j"/>

            <!-- Jakarta Mail, used by the mail package's SMTP transport.
                 WildFly adds this one implicitly too, for the same reason it
                 adds JPA and CDI: it is part of the EE platform. Declaring it
                 anyway follows the rule above - a dependency you can read is
                 worth more than a default you have to remember. If it ever
                 vanishes from the implicit set, the failure without this line
                 is a NoClassDefFoundError for jakarta.mail.Session at the first
                 send, long after deployment reported success. -->
            <module name="jakarta.mail.api"/>
        </dependencies>
    </deployment>
</jboss-deployment-structure>
