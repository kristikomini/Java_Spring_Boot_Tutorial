<?xml version="1.0" encoding="UTF-8"?>
<!--
  ============================================================================
  beans.xml  -  THE CDI DEPLOYMENT DESCRIPTOR
  ============================================================================
  CDI = Contexts and Dependency Injection. It is the backbone of modern
  Jakarta EE: it decides which classes are "beans", creates them, injects them
  into each other, and destroys them at the right time.

  The presence of this file marks the archive as a "bean archive" so the
  container scans it.

  bean-discovery-mode:
    annotated  (default, and what we want) - only classes carrying a bean
               defining annotation (@ApplicationScoped, @RequestScoped,
               @Dependent, @Singleton, @Stateless...) become beans.
    all        - every class becomes a bean. Deprecated in CDI 4.0 because it
               made deployments slow and made accidental injection possible.

  SCOPES - the "Contexts" half of CDI. This is the concept interviewers ask
  about most:
    @ApplicationScoped  one instance for the whole application. Use for
                        stateless services and repositories. Our default.
    @RequestScoped      one instance per HTTP request.
    @SessionScoped      one per HTTP session (requires Serializable).
    @Dependent          no context of its own; lives and dies with whatever
                        injected it. The default when you annotate nothing.
  ============================================================================
-->
<beans xmlns="https://jakarta.ee/xml/ns/jakartaee"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="https://jakarta.ee/xml/ns/jakartaee
                           https://jakarta.ee/xml/ns/jakartaee/beans_4_1.xsd"
       version="4.1"
       bean-discovery-mode="annotated">

    <!--
      NOTE ON INTERCEPTORS
      Historically you had to list every interceptor here, in order:

          <interceptors>
              <class>it.unicam.cs.enrollment.common.logging.LoggingInterceptor</class>
          </interceptors>

      Since CDI 1.1 the modern way is to put @Priority on the interceptor class
      itself, which enables it globally and defines its ordering. We use that
      approach (see LoggingInterceptor) - hence this section is intentionally
      empty. Knowing both matters, because you will meet the XML form in any
      codebase older than a few years.
    -->

</beans>
