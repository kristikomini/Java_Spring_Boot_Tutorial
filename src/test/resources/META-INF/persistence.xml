<?xml version="1.0" encoding="UTF-8"?>
<!--
  ============================================================================
  THE TEST PERSISTENCE UNIT
  ============================================================================
  This file SHADOWS src/main/resources/META-INF/persistence.xml during tests:
  both live at the same classpath location, and test resources come first. That
  is a standard Maven trick and the reason the production unit is not visible
  here.

  Two differences from the production unit, and both are forced by the
  environment rather than chosen:

    transaction-type="RESOURCE_LOCAL"
        There is no application server in a unit test, so there is no JTA
        transaction manager. The test drives transactions itself with
        em.getTransaction().begin() / commit().

    an explicit connection, not a <jta-data-source>
        No JNDI either, so the JDBC URL and credentials appear directly.

    <class> elements listed one by one
        Outside a container, entity auto-discovery is not guaranteed. Listing
        them is a small maintenance cost in exchange for a unit that always
        behaves the same way. A new entity must be added here or its tests will
        fail with "Unknown entity".

  ============================================================================
  WHY H2 IN MEMORY, AND WHAT IT COSTS YOU
  ============================================================================
  H2 starts in milliseconds, needs no Docker, and is discarded when the JVM
  exits - so repository tests run on every build and in any CI environment.

  The trade-off is real and worth stating: H2 is NOT PostgreSQL. It differs in
  SQL dialect details, in locking behaviour, in sequence handling and in error
  messages. A query that works here can still fail in production.

  The professional answer is TESTCONTAINERS: it starts a real PostgreSQL in
  Docker for the test run, so you test against the database you actually ship
  against. Adopt it once you are comfortable with the basics - the concepts in
  these tests carry over unchanged.
-->
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence
                                 https://jakarta.ee/xml/ns/persistence/persistence_3_2.xsd"
             version="3.2">

    <persistence-unit name="enrollmentTestPU" transaction-type="RESOURCE_LOCAL">

        <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>

        <class>it.unicam.cs.enrollment.domain.model.Student</class>
        <class>it.unicam.cs.enrollment.domain.model.Professor</class>
        <class>it.unicam.cs.enrollment.domain.model.Course</class>
        <class>it.unicam.cs.enrollment.domain.model.Enrollment</class>

        <!-- The fieldbook bounded context. Listed separately so it is obvious
             at a glance that these are a different group of tables serving a
             different model - see V3__fieldbook_accounts.sql. -->
        <class>it.unicam.cs.enrollment.fieldbook.domain.LearnerAccount</class>
        <class>it.unicam.cs.enrollment.fieldbook.domain.AuthSession</class>
        <class>it.unicam.cs.enrollment.fieldbook.domain.CardProgress</class>
        <class>it.unicam.cs.enrollment.fieldbook.domain.ChapterProgress</class>
        <class>it.unicam.cs.enrollment.fieldbook.domain.StickyNote</class>

        <!-- The mail outbox. A third group again: it belongs to neither the
             registrar nor the fieldbook, and nothing joins to it - see
             V4__mail_outbox.sql for why an outbox row deliberately has no
             foreign key back to whatever caused it. -->
        <class>it.unicam.cs.enrollment.mail.domain.OutboxMessage</class>

        <exclude-unlisted-classes>true</exclude-unlisted-classes>

        <properties>
            <property name="jakarta.persistence.jdbc.driver" value="org.h2.Driver"/>
            <!--
              DB_CLOSE_DELAY=-1 keeps the in-memory database alive as long as the
              JVM runs. Without it H2 destroys the database the moment the last
              connection closes, and the second test in a class finds no tables.
            -->
            <property name="jakarta.persistence.jdbc.url"
                      value="jdbc:h2:mem:enrollment_test;DB_CLOSE_DELAY=-1;MODE=PostgreSQL"/>
            <property name="jakarta.persistence.jdbc.user" value="sa"/>
            <property name="jakarta.persistence.jdbc.password" value=""/>

            <!--
              drop-and-create, not update: every test run starts from a schema
              generated fresh out of the current entity mappings. Tests must
              never depend on leftover state.
            -->
            <property name="jakarta.persistence.schema-generation.database.action"
                      value="drop-and-create"/>

            <property name="hibernate.show_sql" value="false"/>
            <property name="hibernate.format_sql" value="true"/>

            <!--
              MIRRORED FROM THE PRODUCTION UNIT.
              A bug once reached the running server because this setting was on
              in production and off here: combining setMaxResults() with a
              collection fetch join threw at runtime but passed every test.

              The lesson generalises: a test persistence unit that is configured
              differently from the real one will happily prove the wrong thing.
              Keep the settings that affect BEHAVIOUR identical, and let only the
              ones that must differ (transaction type, JDBC connection) diverge.
            -->
            <property name="hibernate.query.fail_on_pagination_over_collection_fetch"
                      value="true"/>
        </properties>
    </persistence-unit>
</persistence>
