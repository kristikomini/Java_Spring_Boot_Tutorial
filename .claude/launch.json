{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "angular-client",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "ng",
        "serve",
        "--port",
        "4280"
      ],
      "port": 4280,
      "cwd": "angular-client"
    },
    {
      "name": "fieldbook",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "--yes",
        "http-server",
        "src/main/resources/static",
        "-p",
        "4285",
        "-c-1"
      ],
      "port": 4285
    },
    {
      "name": "app",
      "runtimeExecutable": "mvn",
      "runtimeArgs": [
        "spring-boot:run"
      ],
      "port": 8280,
      "url": "http://localhost:8280"
    }
  ]
}
