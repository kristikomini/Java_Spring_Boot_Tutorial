# ---------------------------------------------------------------------------
# Build output - never commit compiled artifacts. The build regenerates them.
# ---------------------------------------------------------------------------
target/
docker/deployments/*.war
docker/deployments/*.deployed
docker/deployments/*.failed
docker/deployments/*.undeployed
docker/deployments/*.isdeploying
docker/deployments/*.pending
docker/deployments/*.skipdeploy
docker/deployments/*.dodeploy

# ---------------------------------------------------------------------------
# IDE metadata - personal to each developer, not to the project.
# ---------------------------------------------------------------------------
.idea/
*.iml
*.iws
*.ipr
.vscode/
.classpath
.project
.settings/
bin/
nbproject/private/

# ---------------------------------------------------------------------------
# Local environment overrides. Committing real secrets is the single most
# common security incident in small teams - keep .env out of git and commit
# a .env.example with placeholder values instead.
# ---------------------------------------------------------------------------
.env
# .env alone does not match .env.prod - a gitignore pattern is a filename, not
# a prefix. The production secrets file is the one that would actually hurt,
# so match every variant and then un-ignore the committed examples. The
# negation must come after the pattern it exempts from; the order here is not
# stylistic.
.env.*
!.env.example
!.env.prod.example
*.local

# ---------------------------------------------------------------------------
# OS noise
# ---------------------------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini

# ---------------------------------------------------------------------------
# Logs and temporary files
# ---------------------------------------------------------------------------
*.log
*.tmp
hs_err_pid*.log

# Angular client
angular-client/node_modules/
angular-client/dist/
angular-client/.angular/
